{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": [
        "public/**",
        "js/**"
      ]
    },
    "api/*.js": {
      "includeFiles": [
        "public/**",
        "js/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?_path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/css/(.*)",
      "destination": "/public/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/public/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/public/assets/$1"
    },
    {
      "source": "/((?!api|css|js|assets|favicon.ico).*)",
      "destination": "/public/index.html"
    }
  ]
}
